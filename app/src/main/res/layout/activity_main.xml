<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_crema"
    android:orientation="vertical">

    <!-- ENCABEZADO: nombre de la app y buscador -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/blanco"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="26dp"
        android:paddingEnd="20dp"
        android:paddingBottom="18dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pink Library"
            android:textColor="@color/texto_ciruela"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Descubre tu próxima lectura"
            android:textColor="@color/rosa_principal"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etBuscar"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/bg_buscador"
                android:hint="Buscar libro, autor o tema"
                android:inputType="text"
                android:maxLines="1"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:textColor="@color/texto_ciruela"
                android:textColorHint="@color/hint_rosa"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnBuscar"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_boton_rosa"
                android:minWidth="0dp"
                android:paddingStart="22dp"
                android:paddingEnd="22dp"
                android:text="Buscar"
                android:textAllCaps="false"
                android:textColor="@color/blanco"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- CATEGORIAS LITERARIAS (usan el servicio 2 de la API) -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="16dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/contenedorCategorias"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <Button
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_categoria"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:tag="romance"
                android:text="Romance"
                android:textAllCaps="false"
                android:textColor="@color/texto_ciruela"
                android:textSize="13sp" />

            <Button
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_categoria"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:tag="fantasy"
                android:text="Fantasía"
                android:textAllCaps="false"
                android:textColor="@color/texto_ciruela"
                android:textSize="13sp" />

            <Button
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_categoria"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:tag="mystery"
                android:text="Misterio"
                android:textAllCaps="false"
                android:textColor="@color/texto_ciruela"
                android:textSize="13sp" />

            <Button
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_categoria"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:tag="young_adult"
                android:text="Juvenil"
                android:textAllCaps="false"
                android:textColor="@color/texto_ciruela"
                android:textSize="13sp" />

            <Button
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_categoria"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:tag="science_fiction"
                android:text="Ciencia ficción"
                android:textAllCaps="false"
                android:textColor="@color/texto_ciruela"
                android:textSize="13sp" />

            <Button
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:background="@drawable/bg_categoria"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:tag="poetry"
                android:text="Poesía"
                android:textAllCaps="false"
                android:textColor="@color/texto_ciruela"
                android:textSize="13sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- TITULO DE LA SECCION -->
    <TextView
        android:id="@+id/tvSeccion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="18dp"
        android:layout_marginBottom="12dp"
        android:text="Recomendados para ti"
        android:textColor="@color/texto_ciruela"
        android:textSize="18sp"
        android:textStyle="bold" />

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="24dp"
        android:indeterminateTint="@color/rosa_principal"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvMensaje"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:gravity="center"
        android:paddingStart="30dp"
        android:paddingEnd="30dp"
        android:text=""
        android:textColor="@color/texto_suave"
        android:textSize="14sp"
        android:visibility="gone" />

    <!-- LISTA DE LIBROS -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvLibros"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="16dp" />

</LinearLayout>
